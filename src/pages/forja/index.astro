---
/*
  THESIS: La Forja turns engineering judgment into visible, playable decisions.
  OWN-WORLD: a full-screen product room, related to the publication by type and
  restraint but denser, more operational and more tactile.
  STORY: promise, real context, product proof, evaluation sequence, then real
  product captures that show the canvas and its verdict without loading the app.
  FIRST VIEWPORT: one decision-led headline on the left and one semantic product
  demonstration over a human business context on the right.
  FORM: dark graphite field, forge green as punctuation, documentary imagery,
  firm rules, asymmetric columns and a single non-looping reveal.
*/
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LEVELS } from '../../lib/forja/progression/levels';
import { orderLevelEntries } from '../../lib/forja/progression/level-listing';
import { isPlayable } from '../../lib/forja/progression/types';

const playableExercises = await getCollection('forjaExercises', ({ data }) => isPlayable(data.status));
const levelCount = LEVELS.length;
const exerciseCount = playableExercises.length;
const firstLevel = LEVELS[0];
const firstExercise = orderLevelEntries(
  playableExercises.filter((exercise) => exercise.data.level === firstLevel.id),
)[0];
const firstExerciseHref = firstExercise
  ? `/forja/${firstLevel.id}/${firstExercise.id}`
  : '/forja/niveles';
---

<BaseLayout
  title="La Forja: decisiones de arquitectura de software | Ingeniería sin filtros"
  description={`Resolvé problemas reales de negocio y descubrí qué se rompe y quién paga cada decisión. ${levelCount} niveles, ${exerciseCount} ejercicios jugables.`}
  image="/forja/problem-pharmacy-documentary.webp"
  chrome="app-landing"
  noindex={true}
>
  <div class="forja-landing">
    <section class="launch" aria-labelledby="forja-title">
      <header class="product-header">
        <a class="product-mark" href="/forja" aria-label="La Forja, inicio">
          <span class="product-mark__symbol" aria-hidden="true">F</span>
          <span>
            <strong>La Forja</strong>
            <small>Ingeniería sin filtros</small>
          </span>
        </a>

        <nav aria-label="Navegación principal" class="product-nav">
          <a href="/" aria-label="Blog: volver a la publicación">Volver a la publicación</a>
          <span class="authorship">Creada por Alejandro Lafourcade</span>
          <button class="theme-control" id="forja-theme-toggle" type="button" aria-label="Cambiar tema">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.64 5.64l1.42 1.42M16.94 16.94l1.42 1.42M18.36 5.64l-1.42 1.42M7.06 16.94l-1.42 1.42" />
              <circle cx="12" cy="12" r="4" />
            </svg>
          </button>
        </nav>
      </header>

      <div class="launch-grid">
        <div class="thesis">
          <p class="mobile-authorship">Creada por Alejandro Lafourcade</p>
          <p class="eyebrow">Entrenamiento de criterio técnico</p>
          <h1 id="forja-title">
            <span>No estudies</span>
            <span class="architecture-line">arquitectura.</span>
            <span class="accent-line">Tomá decisiones.</span>
          </h1>
          <p class="promise">
            Recibís un problema real de negocio, construís o reparás el sistema y un motor determinista
            te dice qué se rompe y quién paga el costo. No evalúa una opinión. Evalúa las garantías y
            restricciones que el problema declara.
          </p>
          <div class="actions">
            <a class="primary-action" href={firstExerciseHref}>Empezar el primer desafío</a>
            <a class="secondary-action" href="#como-funciona">Ver cómo funciona</a>
          </div>
          <p class="access-note">Gratis. Sin cuenta. El lienzo se juega en escritorio.</p>
        </div>

        <figure class="product-proof">
          <img
            src="/forja/forja-systems-table-v2.webp"
            alt="Instalación física de un sistema distribuido construida con planos, conexiones y nodos"
            width="1672"
            height="941"
            loading="eager"
            fetchpriority="high"
          />
          <div class="photo-wash" aria-hidden="true"></div>

          <div class="signal-field" aria-hidden="true">
            <svg viewBox="0 0 800 640" preserveAspectRatio="none">
              <path class="signal-path signal-path--one" d="M104 160 C250 105 302 260 430 228 S602 102 720 174" />
              <path class="signal-path signal-path--two" d="M152 474 C280 370 352 520 492 420 S650 348 740 470" />
              <path class="signal-path signal-path--risk" d="M430 228 C476 290 468 352 492 420" />
            </svg>
            <span class="signal-node signal-node--one"></span>
            <span class="signal-node signal-node--two"></span>
            <span class="signal-node signal-node--three"></span>
            <span class="signal-node signal-node--four"></span>
            <span class="signal-node signal-node--risk"></span>
          </div>

          <div class="verdict-card" aria-label="Vista previa de una decisión dentro de La Forja">
            <div class="verdict-card__topline">
              <span>Motor determinista</span>
              <span>Mismo diseño, mismo veredicto</span>
            </div>
            <div class="verdict-card__score"><strong>50</strong><span>/100</span></div>
            <p>El dato regulado sale del límite declarado.</p>
            <dl>
              <div><dt>Qué se rompe</dt><dd>Trazabilidad</dd></div>
              <div><dt>Quién paga</dt><dd>La farmacia</dd></div>
            </dl>
          </div>

          <figcaption>La arquitectura deja de ser una opinión cuando el costo se vuelve visible.</figcaption>
        </figure>
      </div>

      <ol class="proof-sequence" id="como-funciona" aria-label="Cómo funciona La Forja">
        <li>
          <span>01</span>
          <div><strong>Decidís</strong><p>Movés piezas, declarás conexiones y elegís qué costo aceptar.</p></div>
        </li>
        <li>
          <span>02</span>
          <div><strong>El sistema evalúa</strong><p>El mismo diseño obtiene siempre el mismo resultado.</p></div>
        </li>
        <li>
          <span>03</span>
          <div><strong>Entendés el costo</strong><p>Cada punto perdido nombra qué se rompe y quién lo paga.</p></div>
        </li>
      </ol>
    </section>

    <section class="difference" aria-labelledby="difference-title">
      <div class="difference__statement">
        <p class="eyebrow">No es un quiz de arquitectura</p>
        <h2 id="difference-title">Tu diagrama deja rastro.</h2>
        <p>
          No buscás la respuesta escondida. Construís una solución, declarás qué cruza cada límite y
          defendés lo que aceptaste perder. El motor evalúa las garantías del problema, no tu capacidad
          para adivinar una palabra.
        </p>
      </div>
      <div class="difference__evidence" aria-label="Evidencia del producto">
        <div><strong>{exerciseCount}</strong><span>ejercicios jugables</span><p>Problemas con restricciones, antagonistas y costos reales.</p></div>
        <div><strong>{levelCount}</strong><span>niveles</span><p>Un recorrido que aumenta la presión sobre tu criterio.</p></div>
        <div><strong>=</strong><span>resultado reproducible</span><p>El mismo diseño recibe siempre el mismo veredicto.</p></div>
      </div>
    </section>

    <section class="product-tour" aria-labelledby="product-tour-title">
      <div class="product-tour__intro">
        <div>
          <p class="eyebrow">El producto, sin maquillaje</p>
          <h2 id="product-tour-title">Así se trabaja en La Forja.</h2>
          <p>
            Leés una situación real, intervenís el sistema y recibís un veredicto que conecta cada
            punto perdido con una consecuencia. Estas son capturas reales del producto, no una demo
            inventada para la landing.
          </p>
        </div>
        <a class="level-link" href="/forja/niveles">Ver los {levelCount} niveles</a>
      </div>

      <div class="product-gallery">
        <figure class="product-shot product-shot--canvas">
          <div class="product-shot__frame">
            <img
              src="/forja/product-canvas.webp"
              alt="Lienzo real de La Forja con la consigna, el diagrama por zonas y la biblioteca de componentes"
              width="1280"
              height="660"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span>Construís</span>
            <strong>El diagrama es tu respuesta.</strong>
            <p>No elegís una opción. Movés límites, conectás piezas y sostenés el costo.</p>
          </figcaption>
        </figure>

        <figure class="product-shot product-shot--score">
          <div class="product-shot__frame">
            <img
              src="/forja/product-score.webp"
              alt="Resultado real de La Forja con un puntaje de 50 sobre 100, ejes evaluados y un hallazgo explicado"
              width="1280"
              height="660"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span>Evaluás</span>
            <strong>50 no es un número vacío.</strong>
            <p>El puntaje nombra qué garantía falta, cuánto cuesta y qué consecuencia produce.</p>
          </figcaption>
        </figure>

        <figure class="product-shot product-shot--list">
          <div class="product-shot__frame">
            <img
              src="/forja/product-list.webp"
              alt="Vista de lista real de La Forja con componentes, conexiones y decisiones configurables"
              width="1280"
              height="660"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span>Entendés</span>
            <strong>Cada pieza tiene una consecuencia.</strong>
            <p>La lista vuelve explícitos los componentes, las conexiones y sus decisiones.</p>
          </figcaption>
        </figure>
      </div>

      <div class="product-tour__closing">
        <p>El lienzo real se abre cuando entrás a un desafío. En mobile podés recorrer la propuesta, pero se juega en escritorio.</p>
        <div class="product-tour__actions">
          <a class="secondary-action" href="/forja/lienzo">Abrir el lienzo libre</a>
          <a class="primary-action" href={firstExerciseHref}>Entrar al primer desafío</a>
        </div>
      </div>
    </section>

    <section class="real-context" aria-labelledby="real-context-title">
      <figure>
        <img
          src="/forja/problem-pharmacy-documentary.webp"
          alt="Una trabajadora revisa medicación en una farmacia, contexto del primer problema de negocio"
          width="3504"
          height="2336"
          loading="lazy"
        />
        <figcaption>El primer desafío empieza en una farmacia, no en una definición.</figcaption>
      </figure>
      <div>
        <p class="eyebrow">Primero el negocio</p>
        <h2 id="real-context-title">La arquitectura aparece cuando algo importa.</h2>
        <p>
          Una venta que no puede esperar. Un comprobante que debe sobrevivir cinco años. Un dato que
          no puede salir de su frontera. La Forja te obliga a diseñar desde esa consecuencia.
        </p>
        <a class="secondary-action" href="/forja/niveles">Recorrer el mapa de niveles</a>
      </div>
    </section>

    <section class="final-pitch" aria-labelledby="final-pitch-title">
      <div class="final-pitch__signal" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
      <p class="eyebrow">Pensar mejor requiere práctica</p>
      <h2 id="final-pitch-title">El código se acelera.<br />Tu criterio se entrena.</h2>
      <p>Entrá sin cuenta, resolvé el primer problema y dejá que el costo de tu decisión te enseñe.</p>
      <div class="actions">
        <a class="primary-action" href={firstExerciseHref}>Entrar a La Forja</a>
        <a class="secondary-action" href="/forja/lienzo">Explorar el lienzo libre</a>
      </div>
    </section>
  </div>

  <script>
    const themeToggle = document.getElementById('forja-theme-toggle');
    themeToggle?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch {
        // The control remains useful when private browsing rejects persistence.
      }
    });
  </script>

  <style>
    .forja-landing {
      --forge-field: rgb(var(--bg-deep));
      --forge-surface: rgb(var(--bg-surface));
      --forge-surface-raised: rgb(var(--bg-raised));
      --forge-rule: rgb(var(--border-card));
      --forge-text: rgb(var(--txt-primary));
      --forge-muted: rgb(var(--txt-secondary));
      --forge-green: rgb(var(--accent));
      --forge-green-ink: rgb(var(--on-accent));
      --forge-danger: rgb(var(--danger-ink));
      min-height: 100vh;
      color: var(--forge-text);
      background: var(--forge-field);
    }

    .launch {
      min-height: 100svh;
      display: grid;
      grid-template-rows: auto 1fr auto;
      color: #f1f4f2;
      background: #080d11;
      border-bottom: 1px solid #26302d;
    }

    .product-header {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 12px clamp(20px, 3vw, 52px);
      border-bottom: 1px solid #26302d;
    }

    .product-mark,
    .product-nav,
    .actions,
    .proof-sequence li,
    .product-tour__intro,
    .product-tour__closing {
      display: flex;
      align-items: center;
    }

    .product-mark {
      gap: 12px;
      color: #f1f4f2;
      text-decoration: none;
    }

    .product-mark__symbol {
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      font-family: 'Outfit', sans-serif;
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--forge-green-ink);
      background: var(--forge-green);
    }

    .product-mark strong,
    .product-mark small {
      display: block;
    }

    .product-mark strong {
      font-family: 'Outfit', sans-serif;
      font-size: 1rem;
    }

    .product-mark small,
    .authorship,
    .eyebrow,
    .proof-sequence > li > span {
      font-family: 'JetBrains Mono', monospace;
      letter-spacing: 0.05em;
    }

    .product-mark small {
      margin-top: 2px;
      font-size: 0.68rem;
      color: #9ca8a3;
    }

    .product-nav {
      justify-content: flex-end;
      gap: clamp(12px, 2vw, 30px);
      font-size: 0.78rem;
      color: #9ca8a3;
    }

    .product-nav a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      color: #f1f4f2;
      text-decoration: none;
      border-bottom: 1px solid var(--forge-green);
    }

    .authorship {
      font-size: 0.66rem;
      text-transform: uppercase;
    }

    .theme-control {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border: 1px solid #36423d;
      color: #f1f4f2;
      background: transparent;
      cursor: pointer;
    }

    .theme-control svg {
      width: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
    }

    .launch-grid {
      min-height: 0;
      min-width: 0;
      display: grid;
      grid-template-columns: minmax(330px, 0.82fr) minmax(560px, 1.35fr);
    }

    .thesis {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(48px, 7vh, 90px) clamp(24px, 5vw, 80px);
      border-right: 1px solid #26302d;
      min-width: 0;
    }

    .eyebrow,
    .panel-label {
      margin: 0;
      font-size: 0.66rem;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--forge-green);
    }

    .thesis h1 {
      max-width: 760px;
      margin: 22px 0 0;
      font-family: 'Outfit', sans-serif;
      font-size: clamp(3.25rem, 5.8vw, 6rem);
      font-weight: 800;
      line-height: 0.88;
      letter-spacing: -0.04em;
      text-transform: uppercase;
    }

    .thesis h1 span {
      display: block;
    }

    .accent-line {
      color: var(--forge-green);
    }

    @media (min-width: 768px) {
      .architecture-line {
        max-width: 100%;
        font-size: 0.82em;
      }
    }

    .promise {
      max-width: 620px;
      margin: clamp(28px, 4vh, 46px) 0 0;
      font-size: clamp(0.98rem, 1.15vw, 1.16rem);
      line-height: 1.7;
      color: #a8b2ad;
    }

    .actions {
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 32px;
    }

    .primary-action,
    .secondary-action,
    .level-link {
      min-height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 20px;
      font-size: 0.88rem;
      font-weight: 700;
      text-decoration: none;
    }

    .primary-action {
      color: var(--forge-green-ink);
      background: var(--forge-green);
    }

    .secondary-action,
    .level-link {
      color: var(--forge-text);
      border: 1px solid var(--forge-rule);
    }

    .primary-action,
    .secondary-action,
    .level-link,
    .product-nav a,
    .theme-control {
      transition: transform 160ms ease, color 160ms ease, border-color 160ms ease, background-color 160ms ease;
    }

    .primary-action:hover,
    .secondary-action:hover,
    .level-link:hover {
      transform: translateY(-2px);
    }

    .secondary-action:hover,
    .level-link:hover,
    .theme-control:hover {
      border-color: var(--forge-green);
    }

    .access-note {
      margin: 16px 0 0;
      font-size: 0.78rem;
      color: #9ca8a3;
    }

    .mobile-authorship {
      display: none;
      margin: 0 0 18px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.62rem;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #9ca8a3;
    }

    .product-proof {
      position: relative;
      min-height: 580px;
      margin: 0;
      overflow: hidden;
      background: #18201d;
    }

    .product-proof > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 62% center;
      filter: saturate(0.82) contrast(1.08);
    }

    .photo-wash {
      position: absolute;
      inset: 0;
      background: rgb(4 8 10 / 0.22);
    }

    .signal-field {
      position: absolute;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
    }

    .signal-field svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      filter: drop-shadow(0 6px 16px rgb(0 0 0 / 0.35));
    }

    .signal-path {
      fill: none;
      stroke: rgb(214 224 219 / 0.5);
      stroke-width: 1.1;
      stroke-dasharray: 8 10;
      animation: signal-travel 18s linear infinite;
    }

    .signal-path--two { animation-delay: -7s; }
    .signal-path--risk { stroke: #ff8c68; animation-duration: 11s; }

    .signal-node {
      position: absolute;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #dce4df;
      box-shadow: 0 8px 20px rgb(0 0 0 / 0.5);
      animation: node-breathe 5s cubic-bezier(0.16, 1, 0.3, 1) infinite alternate;
    }

    .signal-node--one { left: 12%; top: 23%; }
    .signal-node--two { left: 48%; top: 33%; animation-delay: -1.8s; }
    .signal-node--three { right: 9%; top: 24%; animation-delay: -3.2s; }
    .signal-node--four { right: 28%; bottom: 24%; background: #48d994; animation-delay: -4s; }
    .signal-node--risk { left: 51%; bottom: 27%; background: #ff8c68; animation-delay: -2.6s; }

    .verdict-card {
      position: absolute;
      right: clamp(22px, 4vw, 64px);
      bottom: clamp(64px, 9vh, 104px);
      z-index: 2;
      width: min(330px, calc(100% - 44px));
      padding: 22px;
      color: #edf2ef;
      background: rgb(7 11 13 / 0.92);
      border: 1px solid rgb(126 148 138 / 0.7);
      box-shadow: 18px 26px 70px rgb(0 0 0 / 0.48);
      animation: verdict-arrival 800ms 240ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .verdict-card__topline {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.52rem;
      line-height: 1.4;
      text-transform: uppercase;
      color: #93a19a;
    }

    .verdict-card__topline span:first-child { color: #48d994; }

    .verdict-card__score {
      display: flex;
      align-items: baseline;
      margin: 24px 0 6px;
    }

    .verdict-card__score strong {
      font-family: 'Outfit', sans-serif;
      font-size: clamp(3.8rem, 6vw, 5.6rem);
      line-height: 0.8;
      letter-spacing: -0.04em;
      color: #ff8c68;
    }

    .verdict-card__score span { color: #93a19a; }
    .verdict-card > p { margin: 18px 0; font-size: 0.88rem; line-height: 1.5; }
    .verdict-card dl { margin: 0; }
    .verdict-card dl div {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 10px 0;
      border-top: 1px solid #34403b;
      font-size: 0.7rem;
    }
    .verdict-card dt { color: #93a19a; }
    .verdict-card dd { margin: 0; font-weight: 700; }

    .product-proof figcaption {
      position: absolute;
      right: clamp(22px, 4vw, 66px);
      bottom: 22px;
      z-index: 2;
      max-width: 420px;
      font-size: 0.7rem;
      text-align: right;
      color: #eef2ef;
      text-shadow: 0 1px 12px #000;
    }

    .proof-sequence {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin: 0;
      padding: 0 clamp(20px, 3vw, 52px);
      list-style: none;
      border-top: 1px solid #26302d;
    }

    .proof-sequence li {
      min-height: 122px;
      gap: 18px;
      padding: 22px clamp(14px, 2vw, 30px);
      border-right: 1px solid #26302d;
    }

    .proof-sequence li:first-child { padding-left: 0; }
    .proof-sequence li:last-child { border-right: 0; }
    .proof-sequence > li > span { color: var(--forge-green); font-size: 0.62rem; }
    .proof-sequence strong { display: block; font-family: 'Outfit', sans-serif; font-size: 1rem; }
    .proof-sequence p { margin: 4px 0 0; font-size: 0.75rem; line-height: 1.45; color: #9ca8a3; }

    .launch .secondary-action,
    .final-pitch .secondary-action {
      color: #f1f4f2;
      border-color: #46514d;
    }

    .difference {
      display: grid;
      grid-template-columns: minmax(300px, 0.85fr) minmax(520px, 1.15fr);
      gap: clamp(56px, 8vw, 130px);
      padding: clamp(96px, 12vw, 180px) clamp(20px, 6vw, 96px);
      background: var(--forge-field);
      border-bottom: 1px solid var(--forge-rule);
    }

    .difference__statement h2,
    .real-context h2,
