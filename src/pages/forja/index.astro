---
// La Forja — playground canvas (R1-D1). Free-play only: no level/exercise
// content exists yet (R1-F), so this route hosts the canvas alone so the
// gestures are directly playable. `client:only="react"` per design D5 — the
// island measures the DOM (React Flow), so SSR output would be wasted work.
// This is the ONLY React island on the site: no other route pays for it.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ForjaCanvas } from '../../components/forja/canvas/ForjaCanvas';
import RankingStrip from '../../components/forja/RankingStrip.astro';
---

<BaseLayout
  title="La Forja — Playground | Ingeniería sin filtros"
  description="Construí un diseño de sistema en el lienzo y recibí feedback del motor de evaluación de La Forja."
  navVariant="blog"
  footerVariant="simple"
  noindex={true}
>
  <!--
    The playground is a tool, not an article — it must not inherit the
    site's own centered `max-w-[1440px] mx-auto` shell (BaseLayout.astro,
    shared by every route — out of scope to edit here). `w-screen` +
    `ml/mr-[calc(50%-50vw)]` is the standard "full-bleed breakout": it
    spans the true viewport width and re-centers itself under any
    ancestor, regardless of that ancestor's own max-width. BaseLayout's
    `overflow-x-hidden` on <body> (already present, unrelated to this
    page) absorbs any sub-pixel rounding, so this never causes a
    horizontal scrollbar. Full width minus a small gutter; the intro copy
    alone keeps a readable measure via its own `max-w-2xl`.
  -->
  <section class="relative ml-[calc(50%_-_50vw)] mr-[calc(50%_-_50vw)] w-screen px-4 py-8 md:px-6">
    <header class="mb-6">
      <h1 class="text-2xl font-heading font-bold text-txt-primary">La Forja — Playground</h1>
      <p class="mt-2 max-w-2xl text-sm text-txt-secondary">
        Agregá componentes desde la biblioteca, conectalos y el motor te va a decir qué anda mal y por qué. Todo
        gesto tiene equivalente por teclado: Tab para moverte, Enter para crear/conectar, flechas para mover un
        componente seleccionado, Delete para borrar, Ctrl+Z para deshacer.
      </p>
    </header>
    <ForjaCanvas client:only="react" />
    <!--
      RK1: a non-empty ranking element MUST be present in every La Forja
      view — the spec requires presence and non-zero size, not a specific
      position. Rendered here, outside the React island, so it is on the
      page regardless of which internal ForjaCanvas tab (Lienzo/Vista de
      lista/Resultado) is active — it never unmounts with them. Placed
      AFTER the canvas, not before: an earlier revision placed it above
      and pushed the canvas below a real 1280x720 viewport (measured, not
      guessed — it broke an existing pointer-position test), which is
      exactly the kind of below-the-fold defect this whole change exists
      to fix, not reintroduce elsewhere.
    -->
    <RankingStrip />
  </section>
</BaseLayout>
