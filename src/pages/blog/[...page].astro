---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/Container.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import Card from "../../components/Card.astro";
import PillarCard from "../../components/PillarCard.astro";
import SeriesCard from "../../components/SeriesCard.astro";
import BlogCard from "../../components/BlogCard.astro";
import CTASection from "../../components/CTASection.astro";
import Icon from "../../components/Icon.astro";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return paginate(sorted, { pageSize: 9 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const totalPosts = allPosts.length;
const globalTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();

const dayPosts = allPosts.filter((p) => typeof p.data.day === "number");
const latestDay = dayPosts.length ? Math.max(...dayPosts.map((p) => p.data.day ?? 0)) : 0;

const isFirstPage = page.currentPage === 1;
const featured = isFirstPage ? page.data[0] : null;
const gridPosts = isFirstPage ? page.data.slice(1) : page.data;

function formatDate(date: Date): string {
  return date.toLocaleDateString("es-ES", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
}
function readTimeOf(post: CollectionEntry<"blog">): string {
  const words = (post.body ?? "").split(/\s+/).length;
  return `${Math.max(1, Math.ceil(words / 200))} min read`;
}

const pillars = [
  { icon: "layers", title: "Arquitectura sin filtros", description: "Diseño, límites, trade-offs, DDD y APIs.", href: "/blog" },
  { icon: "server", title: "Producción sin filtros", description: "Logs, métricas, incidentes y performance.", href: "/blog" },
  { icon: "cpu", title: "IA sin filtros", description: "Agentes, RAG y desarrollo asistido con criterio.", href: "/blog" },
  { icon: "git-branch", title: "Carrera sin filtros", description: "Liderazgo técnico, decisiones y crecimiento.", href: "/blog" },
  { icon: "workflow", title: "Laboratorio sin filtros", description: "Productos, prototipos y arquitectura en público.", href: "/blog" },
];

const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
---

<BaseLayout
  title={page.currentPage === 1 ? "Blog | Ingeniería sin filtros" : `Blog · Página ${page.currentPage} | Ingeniería sin filtros`}
  description={page.currentPage === 1 ? "Artículos sobre ingeniería de software, arquitectura de sistemas y las decisiones técnicas que nadie te enseña." : `Artículos sobre ingeniería de software y arquitectura, página ${page.currentPage}.`}
  navVariant="blog"
  footerVariant="full"
>
  <!-- 1. Hero editorial -->
  <section>
    <Container width="wide" class="flex flex-col items-start gap-4 py-14 md:py-16">
      <span class="font-mono text-xs uppercase tracking-[0.18em] text-accent">El blog</span>
      <h1 class="font-heading text-4xl font-extrabold leading-tight tracking-tight text-txt-primary md:text-5xl">Blog</h1>
      <p class="max-w-2xl text-base leading-relaxed text-txt-secondary md:text-lg">
        Ensayos, decisiones técnicas y trade-offs sobre arquitectura, producción e IA. No para
        acumular tutoriales: para aprender a mirar sistemas con más criterio.
      </p>
    </Container>
  </section>

  {isFirstPage && featured && (
    <!-- 2. Artículo destacado -->
    <section class="border-t border-border-subtle">
      <Container width="wide" class="flex flex-col gap-6 py-12 md:py-16">
        <SectionHeader eyebrow="Destacado" title="Empezá por acá" description="Una pieza para entrar al tono del sitio: problema real, decisión técnica y criterio aplicable." />
        <a
          href={`/blog/${featured.id}`}
          class="group grid overflow-hidden rounded-2xl border border-border-subtle bg-bg-surface transition-colors hover:border-accent/40 md:grid-cols-2"
        >
          <div class="aspect-[1200/630] overflow-hidden bg-bg-deep">
            <img src={featured.data.image} alt={featured.data.title} width="1200" height="630" loading="eager" class="h-full w-full object-contain" />
          </div>
          <div class="flex flex-col justify-center gap-4 p-6 md:p-8">
            <div class="flex flex-wrap gap-1.5">
              {featured.data.tags.slice(0, 3).map((tag) => (
                <span class="rounded-md bg-tag-bg px-2.5 py-1 text-xs font-medium text-tag-text">{tag}</span>
              ))}
            </div>
            <h2 class="font-heading text-2xl font-extrabold leading-tight text-txt-primary transition-colors group-hover:text-accent md:text-3xl">
              {featured.data.title}
            </h2>
            <p class="line-clamp-3 leading-relaxed text-txt-secondary">{featured.data.description}</p>
            <div class="flex items-center gap-2 text-xs text-txt-muted">
              <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
              <span class="h-1 w-1 rounded-full bg-txt-muted"></span>
              <span>{readTimeOf(featured)}</span>
            </div>
            <span class="inline-flex items-center gap-1.5 pt-1 font-semibold text-accent">
              Leer artículo
              <Icon name="arrow-right" size={16} />
            </span>
          </div>
        </a>
      </Container>
    </section>

    <!-- 3. Explorá por pilar -->
    <section class="border-t border-border-subtle bg-bg-surface">
      <Container width="wide" class="flex flex-col gap-8 py-12 md:py-16">
        <SectionHeader eyebrow="Explorá por pilar" title="Elegí tu tema" description="Cinco frentes de criterio técnico. Cada uno, una ruta de lectura." />
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
          {pillars.map((pillar) => (
            <PillarCard icon={pillar.icon} title={pillar.title} description={pillar.description} href={pillar.href} />
          ))}
        </div>
      </Container>
    </section>

    <!-- 4. Series -->
    <section class="border-t border-border-subtle">
      <Container width="wide" class="flex flex-col gap-8 py-12 md:py-16">
        <SectionHeader eyebrow="Series" title="Rutas de aprendizaje" />
        <div class="grid gap-4 md:grid-cols-2">
          <SeriesCard
            title="#100ArchitectureDays"
            description="Problemas reales de arquitectura, con código y decisiones. Una ruta, no una lista de posts."
            href="/100-architecture-days"
            badge={`Día ${latestDay} de 110`}
            featured
          />
        </div>
      </Container>
    </section>
  )}

  <!-- 5. Últimos artículos / Archivo -->
  <section class="border-t border-border-subtle">
    <Container width="wide" class="flex flex-col gap-8 py-12 md:py-16">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <SectionHeader eyebrow={isFirstPage ? "Lo último" : `Página ${page.currentPage}`} title={isFirstPage ? "Últimos artículos" : "Más publicaciones"} />
        <span class="font-mono text-xs text-txt-muted">{totalPosts} artículos publicados</span>
      </div>

      <!-- Search -->
      <div class="search-container flex h-12 w-full max-w-[560px] items-center gap-3 rounded-xl border border-border-subtle bg-bg-surface px-4 transition-all duration-300 focus-within:border-accent/50">
        <Icon name="search" size={18} class="shrink-0 text-txt-muted" />
        <input id="blog-search" type="text" placeholder="Buscar artículos..." aria-label="Buscar artículos" class="flex-1 bg-transparent text-[15px] text-txt-primary outline-none placeholder:text-txt-muted" />
      </div>

      <!-- Tag links -->
      <div class="flex flex-wrap items-center gap-2.5">
        <a href="/blog" class="rounded-full border border-accent/40 bg-accent/10 px-4 py-2 text-[13px] font-semibold text-accent">Todos</a>
        {globalTags.map((tag) => (
          <a href={`/blog/tags/${tag}`} class="rounded-full border border-border-subtle bg-bg-surface px-4 py-2 text-[13px] font-medium text-txt-secondary transition-colors hover:border-accent/50 hover:text-txt-primary">{tag}</a>
        ))}
      </div>

      <!-- Grid -->
      <div id="blog-grid" class="grid gap-5 sm:grid-cols-2">
        {gridPosts.map((post) => (
          <BlogCard
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            tags={post.data.tags}
            date={formatDate(post.data.date)}
            readTime={readTimeOf(post)}
            image={post.data.image}
          />
        ))}
      </div>
      <p id="no-results" class="hidden py-12 text-center text-txt-muted">No se encontraron artículos.</p>
    </Container>
  </section>

  <!-- Pagination -->
  {page.lastPage > 1 && (
    <nav aria-label="Paginación del blog" class="flex items-center justify-center gap-2 px-4 pb-16 sm:px-6 md:px-10 lg:px-20">
      {page.url.prev ? (
        <a href={page.url.prev} class="rounded-full border border-border-subtle bg-bg-surface px-4 py-2.5 text-[13px] font-medium text-txt-secondary transition-colors hover:border-accent/50 hover:text-txt-primary">&larr; Anterior</a>
      ) : (
        <span class="rounded-full border border-border-subtle bg-bg-surface px-4 py-2.5 text-[13px] font-medium text-txt-muted opacity-50">&larr; Anterior</span>
      )}
      {pageNumbers.map((num) => {
        const isActive = num === page.currentPage;
        const href = num === 1 ? "/blog" : `/blog/${num}`;
        return isActive ? (
          <span class="min-w-[44px] rounded-full bg-accent px-4 py-2.5 text-center text-[13px] font-semibold text-bg-deep" aria-current="page">{num}</span>
        ) : (
          <a href={href} class="min-w-[44px] rounded-full border border-border-subtle bg-bg-surface px-4 py-2.5 text-center text-[13px] font-medium text-txt-secondary transition-colors hover:border-accent/50 hover:text-txt-primary">{num}</a>
        );
      })}
      {page.url.next ? (
        <a href={page.url.next} class="rounded-full border border-border-subtle bg-bg-surface px-4 py-2.5 text-[13px] font-medium text-txt-secondary transition-colors hover:border-accent/50 hover:text-txt-primary">Siguiente &rarr;</a>
      ) : (
        <span class="rounded-full border border-border-subtle bg-bg-surface px-4 py-2.5 text-[13px] font-medium text-txt-muted opacity-50">Siguiente &rarr;</span>
      )}
    </nav>
  )}

  <!-- 6. CTA La Bitácora -->
  <section class="border-t border-border-subtle">
    <Container width="wide">
      <CTASection
        eyebrow="Newsletter"
        title="¿Te quedaste con ganas de más?"
        description="La Bitácora Sin Filtros: una decisión técnica, sus trade-offs y una regla práctica, una vez por semana."
        primaryLabel="Suscribirme a La Bitácora"
        primaryHref="/newsletter"
        secondaryLabel="Ver #100ArchitectureDays"
        secondaryHref="/100-architecture-days"
      />
    </Container>
  </section>
</BaseLayout>

<script>
  // Client-side search filter over the article grid.
  const searchInput = document.getElementById("blog-search") as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>("[data-blog-card]");
  const noResults = document.getElementById("no-results");

  function filterCards() {
    const query = searchInput?.value.toLowerCase() ?? "";
    let visible = 0;
    cards.forEach((card) => {
      const title = card.dataset.title?.toLowerCase() ?? "";
      const description = card.dataset.description?.toLowerCase() ?? "";
      const match = query === "" || title.includes(query) || description.includes(query);
      card.style.display = match ? "" : "none";
      if (match) visible++;
    });
    if (noResults) noResults.style.display = visible === 0 ? "block" : "none";
  }

  searchInput?.addEventListener("input", filterCards);
</script>
