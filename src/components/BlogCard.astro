---
interface Props {
  slug: string
  title: string
  description: string
  tags: string[]
  date: string
  readTime: string
  image: string
}

const { slug, title, description, tags, date, readTime, image } = Astro.props
---

<a
  href={`/blog/${slug}`}
  class="group flex flex-col bg-bg-surface rounded-xl border border-border-subtle overflow-hidden hover:border-accent/30 hover:-translate-y-1 card-hover-shadow transition-all duration-300"
  data-blog-card
  data-tags={tags.join(',')}
  data-title={title.toLowerCase()}
  data-description={description.toLowerCase()}
>
  <div class="relative aspect-[1200/630] overflow-hidden bg-bg-deep">
    <img src={image} alt={title} class="h-full w-full object-contain transition duration-500 group-hover:brightness-110" loading="lazy" width="1200" height="630" />
    <!-- Subtle bottom fade: the poster melts into the card body instead of cutting hard -->
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/4 bg-gradient-to-t from-bg-surface/70 to-transparent" />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
    <div class="flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="text-xs font-medium text-tag-text bg-tag-bg rounded-md px-2.5 py-1 transition-all duration-300 group-hover:bg-accent/20">{tag}</span>
      ))}
    </div>
    <h3 class="text-base font-bold text-txt-primary leading-[1.4] group-hover:text-accent transition-colors duration-300">{title}</h3>
    <p class="text-[13px] text-txt-secondary leading-[1.6] line-clamp-2">{description}</p>
    <div class="flex items-center gap-2 text-xs text-txt-muted mt-auto pt-2">
      <time datetime={date}>{date}</time>
      <span class="w-1 h-1 rounded-full bg-txt-muted" />
      <span>{readTime}</span>
    </div>
  </div>
</a>

