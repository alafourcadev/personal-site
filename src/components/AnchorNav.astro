---
// In-page anchor navigation with scroll-spy. Degrades to plain links if JS fails.
interface AnchorItem {
  label: string;
  href: string;
}

interface Props {
  items: AnchorItem[];
  title?: string;
}

const { items, title = 'En esta página' } = Astro.props;
---

<nav aria-label={title} class="flex flex-col gap-2 text-sm" data-anchor-nav>
  <span class="font-mono text-xs uppercase tracking-wider text-txt-muted">{title}</span>
  <ul class="flex flex-col border-l border-border-subtle">
    {items.map((item) => (
      <li>
        <a
          href={item.href}
          data-anchor-link
          class="-ml-px block border-l-2 border-transparent py-1 pl-4 text-txt-secondary transition-colors hover:text-accent data-[active]:border-accent data-[active]:text-accent"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<script>
  // Highlight the anchor whose target section is currently in view.
  document.querySelectorAll('[data-anchor-nav]').forEach((nav) => {
    const links = Array.from(nav.querySelectorAll('[data-anchor-link]'));
    const sections = new Map<Element, Element>();

    links.forEach((link) => {
      const id = link.getAttribute('href')?.replace('#', '');
      const section = id ? document.getElementById(id) : null;
      if (section) sections.set(section, link);
    });

    if (!sections.size) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((l) => l.removeAttribute('data-active'));
          sections.get(entry.target)?.setAttribute('data-active', '');
        });
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );

    sections.forEach((_, section) => observer.observe(section));
  });
</script>
