---
// A content series (e.g. #100ArchitectureDays) presented as a permanent asset.
import Card from './Card.astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  badge?: string;
  eyebrow?: string;
  featured?: boolean;
}

const { title, description, href, badge, eyebrow = 'Serie', featured = false } = Astro.props;
---

<Card href={href} tone="series" variant={featured ? 'featured' : 'default'}>
  <div class="flex items-center justify-between gap-3">
    <span class="font-mono text-xs uppercase tracking-[0.15em] text-accent">{eyebrow}</span>
    {badge && (
      <span class="rounded-md bg-accent/10 px-2.5 py-1 font-mono text-xs text-accent">{badge}</span>
    )}
  </div>
  <h3 class="font-heading text-xl font-extrabold leading-tight text-txt-primary transition-colors group-hover:text-accent md:text-2xl">
    {title}
  </h3>
  <p class="text-sm leading-relaxed text-txt-secondary md:text-base">{description}</p>
  <span class="mt-auto inline-flex items-center gap-1.5 pt-2 font-semibold text-accent">
    Explorar la serie
    <Icon name="arrow-right" size={16} />
  </span>
</Card>
