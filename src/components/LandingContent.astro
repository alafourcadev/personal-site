---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Container from './Container.astro';
import SectionHeader from './SectionHeader.astro';
import ManifestoBlock from './ManifestoBlock.astro';
import PillarCard from './PillarCard.astro';
import Card from './Card.astro';
import BlogCard from './BlogCard.astro';
import ServiceCard from './ServiceCard.astro';
import QuoteBlock from './QuoteBlock.astro';
import Icon from './Icon.astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestPosts = sorted.slice(0, 6);

// #100ArchitectureDays progress — derived from content so it never goes stale.
const dayPosts = allPosts
  .filter((p) => typeof p.data.day === 'number')
  .sort((a, b) => (b.data.day ?? 0) - (a.data.day ?? 0));
const latestDay = dayPosts.length ? dayPosts[0].data.day ?? 0 : 0;
const lastDayPost = dayPosts[0];
const TOTAL_DAYS = 110;

function formatDate(date: Date): string {
  return date.toLocaleDateString('es-ES', { year: 'numeric', month: 'short', day: 'numeric' });
}

function readTimeOf(post: CollectionEntry<'blog'>): string {
  const words = (post.body ?? '').split(/\s+/).length;
  return `${Math.max(1, Math.ceil(words / 200))} min read`;
}

const pillars = [
  { icon: 'layers', title: 'Arquitectura sin filtros', description: 'Diseñá límites, módulos, APIs y sistemas que no dependan de magia ni slogans.', href: '/blog' },
  { icon: 'server', title: 'Producción sin filtros', description: 'Lo que pasa después del deploy: logs, métricas, incidentes, performance y decisiones que duelen.', href: '/blog' },
  { icon: 'cpu', title: 'IA sin filtros', description: 'Usá IA como ingeniero, no como copiador profesional.', href: '/blog' },
  { icon: 'git-branch', title: 'Carrera sin filtros', description: 'La parte que no sale en los tutoriales: liderazgo, presión, estimaciones y crecimiento real.', href: '/blog' },
  { icon: 'zap', title: 'Laboratorio sin filtros', description: 'Construir en público: productos, prototipos y arquitectura real, con las decisiones a la vista.', href: '/blog' },
];

const services = [
  { icon: 'shield', title: 'Auditoría de arquitectura', description: 'Detectamos riesgos, deuda crítica y problemas de diseño antes de que exploten en producción.' },
  { icon: 'server', title: 'Revisión de backend / APIs', description: 'Diagnóstico de Spring Boot, capas, seguridad, performance y mantenibilidad.' },
  { icon: 'cpu', title: 'IA aplicada para equipos', description: 'Agentes y workflows para incorporar IA sin convertir tu sistema en una caja negra.' },
];

const REPO_URL = 'https://github.com/alafourcadev/100-architecture-days';
const BUTTONDOWN_ACTION = 'https://buttondown.email/api/emails/embed-subscribe/alafourcadedespaigne';
---

<!-- 1. Hero manifiesto -->
<section>
  <Container width="wide" class="flex flex-col items-start gap-6 py-20 md:py-28">
    <span class="font-mono text-xs uppercase tracking-[0.18em] text-accent">
      Ingeniería real para la era de la IA
    </span>
    <h1 class="font-heading text-3xl font-extrabold leading-[1.1] tracking-tight text-txt-primary md:text-5xl lg:text-6xl max-w-4xl">
      Aprendé a diseñar software que aguante producción, no solo demos para LinkedIn.
    </h1>
    <p class="text-base leading-relaxed text-txt-secondary md:text-lg max-w-2xl">
      La IA hace que copiar código sea trivial. El criterio para decidir arquitectura y sostenerla
      en producción, no. Acá, Alejandro Lafourcade escribe sobre arquitectura, producción e IA
      aplicada desde las cicatrices de sistemas que tenían que funcionar.
    </p>
    <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-center">
      <a href="/blog" class="inline-flex items-center justify-center gap-2 rounded-md bg-accent px-6 py-3 font-semibold text-bg-deep transition-colors hover:bg-accent-strong">
        Empezá por acá
        <Icon name="arrow-right" size={16} />
      </a>
      <a href="/blog/tags/100ArchitectureDays" class="inline-flex items-center justify-center rounded-md border border-border-subtle px-6 py-3 font-semibold text-txt-primary transition-colors hover:border-accent hover:text-accent">
        Leer #100ArchitectureDays
      </a>
      <a href="#newsletter" class="inline-flex items-center px-2 py-3 font-mono text-sm text-txt-secondary underline-offset-4 transition-colors hover:text-accent hover:underline">
        Suscribirme a la Bitácora
      </a>
    </div>
  </Container>
</section>

<!-- 2. Manifiesto corto -->
<section class="border-t border-border-subtle">
  <Container width="wide" class="py-16 md:py-20">
    <ManifestoBlock
      eyebrow="El problema"
      statement="La industria está copiando más código que nunca. Entender sistemas sigue siendo el diferencial."
      supporting="La IA aceleró el desarrollo, pero amplificó un problema viejo: mucha gente genera código sin entender las decisiones que lo sostienen. Ingeniería sin filtros existe para volver al centro — arquitectura, producción, trade-offs, debugging, observabilidad y criterio. No se trata de odiar la IA: se trata de usarla sin entregar el volante."
    />
  </Container>
</section>

<!-- 3. Pilares editoriales -->
<section class="border-t border-border-subtle">
  <Container width="wide" class="flex flex-col gap-10 py-16 md:py-20">
    <SectionHeader
      eyebrow="Qué vas a aprender"
      title="Cinco pilares, sin filtros"
      description="Cada pilar es una ruta de criterio técnico, no una lista de tutoriales."
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {pillars.map((pillar) => (
        <PillarCard icon={pillar.icon} title={pillar.title} description={pillar.description} href={pillar.href} />
      ))}
    </div>
  </Container>
</section>

<!-- 4. #100ArchitectureDays -->
<section class="border-t border-border-subtle">
  <Container width="wide" class="flex flex-col gap-8 py-16 md:py-20">
    <SectionHeader
      eyebrow="Ruta de aprendizaje"
      title="#100ArchitectureDays"
      description="No es un reto de contenido: es una ruta para aprender arquitectura como decisiones. 100 días de problemas reales, trade-offs y código cuando hace falta."
    />
    <Card tone="series" variant="featured" class="gap-6">
      <p class="text-txt-secondary leading-relaxed max-w-2xl">
        Cada día es una decisión de arquitectura con su contexto, sus trade-offs y su porqué.
        Seguidos, son un camino de junior a criterio senior — no una lista de posts.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-md bg-accent/10 px-3 py-1 font-mono text-sm text-accent">Día {latestDay} de {TOTAL_DAYS}</span>
        {lastDayPost && (
          <span class="font-mono text-xs text-txt-muted">
            Último publicado: <a href={`/blog/${lastDayPost.id}`} class="text-txt-secondary underline-offset-4 hover:text-accent hover:underline">Día {lastDayPost.data.day} — {lastDayPost.data.title}</a>
          </span>
        )}
      </div>
      <div class="h-1.5 w-full overflow-hidden rounded-full bg-bg-deep" role="progressbar" aria-valuenow={latestDay} aria-valuemin={0} aria-valuemax={TOTAL_DAYS} aria-label="Progreso de la serie">
        <div class="h-full rounded-full bg-accent" style={`width: ${Math.round((latestDay / TOTAL_DAYS) * 100)}%`}></div>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="/blog/100-architecture-days-intro" class="inline-flex items-center justify-center gap-2 rounded-md bg-accent px-5 py-2.5 font-semibold text-bg-deep transition-colors hover:bg-accent-strong">
          Empezar desde el día 1
        </a>
        <a href="/blog/tags/100ArchitectureDays" class="inline-flex items-center justify-center rounded-md border border-border-subtle px-5 py-2.5 font-semibold text-txt-primary transition-colors hover:border-accent hover:text-accent">
          Ver últimos días
        </a>
        <a href={REPO_URL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-md border border-border-subtle px-5 py-2.5 font-semibold text-txt-primary transition-colors hover:border-accent hover:text-accent">
          <Icon name="github" size={16} />
          Ver repo en GitHub
        </a>
      </div>
    </Card>
  </Container>
</section>

<!-- Editorial break -->
<section class="border-t border-border-subtle bg-bg-surface">
  <Container width="default" class="py-16 md:py-24">
    <QuoteBlock
      quote="El código ya lo escribe la IA. El criterio para decidir qué construir, cómo sostenerlo en producción y por qué, todavía lo construís vos."
      attribution="Ingeniería sin filtros"
    />
  </Container>
</section>

<!-- 5. Últimos artículos -->
<section class="border-t border-border-subtle">
  <Container width="wide" class="flex flex-col gap-10 py-16 md:py-20">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeader eyebrow="Lectura" title="Últimos artículos" />
      <a href="/blog" class="inline-flex items-center gap-1.5 font-medium text-accent transition-all hover:gap-2.5">
        Ver todos
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-2">
      {latestPosts.map((post) => (
        <BlogCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          tags={post.data.tags}
          date={formatDate(post.data.date)}
          readTime={readTimeOf(post)}
          image={post.data.image}
        />
      ))}
    </div>
  </Container>
</section>

<!-- 6. Newsletter — La Bitácora Sin Filtros -->
<section id="newsletter" class="border-t border-border-subtle scroll-mt-24">
  <Container width="default" class="py-16 md:py-20">
    <div class="flex flex-col items-start gap-5 rounded-xl border border-accent/30 bg-accent/5 p-8 md:p-12">
      <span class="font-mono text-xs uppercase tracking-[0.18em] text-accent">Newsletter</span>
      <h2 class="font-heading text-3xl font-extrabold leading-tight text-txt-primary md:text-4xl max-w-2xl">
        La Bitácora Sin Filtros
      </h2>
      <p class="text-txt-secondary leading-relaxed max-w-xl">
        Una vez por semana: una decisión técnica real, sus trade-offs, el porqué detrás y una regla
        práctica que podés aplicar el lunes. Sin resúmenes, sin humo.
      </p>
      <form action={BUTTONDOWN_ACTION} method="post" target="_blank" class="flex w-full max-w-md flex-col gap-3 sm:flex-row">
        <label class="sr-only" for="newsletter-email">Tu email</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          placeholder="tu@email.com"
          class="flex-1 rounded-md border border-border-subtle bg-bg-deep px-4 py-3 text-txt-primary placeholder:text-txt-muted focus:border-accent focus:outline-none"
        />
        <input type="hidden" name="embed" value="1" />
        <button type="submit" class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 font-semibold text-bg-deep transition-colors hover:bg-accent-strong">
          Suscribirme gratis
        </button>
      </form>
      <p class="font-mono text-xs text-txt-muted">Sin spam. Sin humo. Solo ingeniería real.</p>
    </div>
  </Container>
</section>

<!-- 7. Trabaja conmigo -->
<section class="border-t border-border-subtle">
  <Container width="wide" class="flex flex-col gap-10 py-16 md:py-20">
    <SectionHeader
      eyebrow="Trabaja conmigo"
      title="¿Necesitás criterio técnico para una decisión importante?"
      description="Reviso arquitectura, diagnostico deuda técnica, ordeno un backend, diseño un MVP serio o incorporo IA sin convertir tu sistema en una caja negra."
    />
    <div class="grid gap-4 md:grid-cols-3">
      {services.map((service) => (
        <ServiceCard icon={service.icon} title={service.title} description={service.description} />
      ))}
    </div>
    <a href="/servicios" class="inline-flex w-fit items-center gap-2 rounded-md bg-accent px-6 py-3 font-semibold text-bg-deep transition-colors hover:bg-accent-strong">
      Ver cómo podemos trabajar juntos
      <Icon name="arrow-right" size={16} />
    </a>
  </Container>
</section>

<!-- 8. Sobre Alejandro -->
<section class="border-t border-border-subtle">
  <Container width="wide" class="py-16 md:py-20">
    <div class="grid items-center gap-8 md:grid-cols-[160px_1fr] md:gap-12">
      <img
        src="/profile-320.webp"
        alt="Alejandro Lafourcade"
        width="160"
        height="160"
        loading="lazy"
        class="h-32 w-32 rounded-xl border border-border-subtle object-cover md:h-40 md:w-40"
      />
      <div class="flex flex-col items-start gap-5">
        <span class="font-mono text-xs uppercase tracking-[0.18em] text-accent">Sobre Alejandro</span>
        <p class="text-lg leading-relaxed text-txt-primary md:text-xl max-w-2xl">
          Arquitecto y líder técnico con más de 10 años construyendo backend, APIs, microservicios,
          CI/CD y sistemas que tenían que operar en serio.
        </p>
        <p class="leading-relaxed text-txt-secondary max-w-2xl">
          Ingeniería sin filtros nació para enseñar lo que normalmente se aprende a golpes: trade-offs,
          errores de producción, decisiones de arquitectura y criterio técnico en una época donde la IA
          hace que todo parezca más fácil de lo que realmente es.
        </p>
        <a href="/sobre-mi" class="inline-flex items-center gap-1.5 font-medium text-accent transition-all hover:gap-2.5">
          Conocer mi historia
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </Container>
</section>

