---
const explorar = [
  { label: 'Empieza aquí', href: '/empieza-aqui' },
  { label: 'Blog', href: '/blog' },
  { label: '#100ArchitectureDays', href: '/100-architecture-days' },
  { label: 'Newsletter', href: '/newsletter' },
];

const alejandro = [
  { label: 'Sobre mí', href: '/sobre-mi' },
  { label: 'Trabaja conmigo', href: '/servicios' },
  { label: 'Mi setup / Uses', href: '/uses' },
];

const recursos = [
  { label: 'GitHub', href: 'https://github.com/alafourcadev', external: true },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/alafourcadedespaigne/', external: true },
  { label: 'RSS', href: '/rss.xml', external: false },
];

const columns = [
  { title: 'Explorar', links: explorar },
  { title: 'Alejandro', links: alejandro },
  { title: 'Recursos', links: recursos },
];
---

<footer class="border-t border-border-subtle mt-16">
  <div class="px-4 sm:px-6 md:px-10 lg:px-20 py-12 md:py-16">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Marca -->
      <div class="flex flex-col gap-3">
        <span class="font-heading text-lg font-extrabold text-txt-primary">Ingeniería sin filtros</span>
        <p class="text-sm leading-relaxed text-txt-muted">
          Ingeniería real, sin filtros.
        </p>
      </div>

      <!-- Columnas de enlaces -->
      {columns.map((col) => (
        <nav aria-label={col.title} class="flex flex-col gap-3">
          <span class="font-mono text-xs uppercase tracking-wider text-txt-muted">{col.title}</span>
          <ul class="flex flex-col gap-2.5">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="text-sm text-txt-secondary transition-colors duration-200 hover:text-accent"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-border-subtle pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-txt-muted">
        &copy; {new Date().getFullYear()} Alejandro Lafourcade. Todos los derechos reservados.
      </p>
      <p class="font-mono text-xs text-txt-muted">alafourca.dev</p>
    </div>
  </div>
</footer>
