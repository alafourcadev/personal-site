---
import Icon from './Icon.astro';

interface Props {
  variant?: 'home' | 'blog';
}

const { variant = 'home' } = Astro.props;
const currentPath = Astro.url.pathname;

const headerLinks = [
  { label: 'Empieza aquí', href: '/empieza-aqui' },
  // Points at the level map, not at `/forja`: the map is where the product
  // actually starts. `/forja` is the free canvas and stays reachable from it.
  { label: 'La Forja', href: '/forja/niveles' },
  { label: 'Blog', href: '/blog' },
  { label: 'Sobre mí', href: '/sobre-mi' },
  { label: 'Newsletter', href: '/newsletter' },
];

const homeLinks = headerLinks;
const blogLinks = headerLinks;

const links = variant === 'blog' ? blogLinks : homeLinks;

function isActive(href: string): boolean {
  if (href.startsWith('#')) return false;
  if (href === '/') return currentPath === '/';
  if (href === '/empieza-aqui') return currentPath === '/empieza-aqui';
  if (href === '/100-architecture-days') return currentPath === '/100-architecture-days';
  // La Forja is a section, not a page: the entry stays current across the
  // level map, a level and an exercise, so the player never loses their place.
  if (href === '/forja/niveles') return currentPath === '/forja' || currentPath.startsWith('/forja/');
  if (href === '/newsletter') return currentPath === '/newsletter';
  if (href === '/blog') return currentPath.startsWith('/blog');
  if (href === '/sobre-mi') return currentPath === '/sobre-mi';
  if (href === '/uses') return currentPath === '/uses';
  if (href === '/servicios') return currentPath === '/servicios';
  return currentPath === href;
}
---

<!--
  Centred with `left-0 right-0 mx-auto w-max`, NOT with `left-1/2
  -translate-x-1/2`. A fixed element positioned only from the left has a
  containing block that starts there, so `left-1/2` left the pill with just
  50% of the viewport to lay itself out in: measured, its content needs
  605px, but at 768–1150px it was handed 384–575px and the flex row shrank
  to fit. "Empieza aquí", "La Forja" and "Sobre mí" each rendered on two
  lines, 39px tall, inside a 44px pill. `left-0 right-0` + auto margins
  centres it against the whole viewport instead, so the pill is always its
  own natural width and nothing wraps. See tests/e2e/site-chrome.spec.ts.
-->
<nav
  aria-label="Navegación principal"
  class="fixed top-3 left-0 right-0 mx-auto w-max z-50 flex items-center justify-center gap-5 h-[44px] px-5 backdrop-blur-xl border border-border-subtle rounded-full shadow-lg shadow-black/5 dark:shadow-black/25 transition-colors duration-300"
  style="background-color: var(--nav-bg)"
>
  <!-- Desktop links -->
  <div class="hidden md:flex items-center gap-5">
    {
      links.map((link, index) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={[
            'nav-link relative text-[13px] transition-all duration-300 hover:text-accent',
            isActive(link.href)
              ? 'text-accent font-medium'
              : 'text-txt-muted hover:text-txt-primary',
          ]}
          style={`animation-delay: ${index * 100}ms`}
        >
          {link.label}
          <span
            class:list={[
              'absolute -bottom-1 left-0 h-0.5 bg-accent transition-all duration-300',
              isActive(link.href) ? 'w-full' : 'w-0 group-hover:w-full',
            ]}
          />
        </a>
      ))
    }
    <span class="text-border-subtle">|</span>
    <button
      id="theme-toggle"
      type="button"
      class="flex items-center justify-center w-9 h-9 text-txt-muted hover:text-txt-primary hover:rotate-12 transition-all duration-300"
      aria-label="Cambiar tema"
    >
      <Icon name="moon" size={16} class="moon-icon" />
      <Icon name="sun" size={16} class="sun-icon hidden" />
    </button>
    <a
      href="/servicios"
      class="ml-1 px-5 py-2 text-[12px] font-bold bg-accent text-bg-deep rounded-full hover:shadow-lg hover:shadow-accent/25 hover:-translate-y-0.5 transition-all duration-300"
    >
      Hablemos
    </a>
  </div>

  <!-- Mobile menu toggle. 44x44 touch target -->
  <button
    id="menu-toggle"
    type="button"
    class="md:hidden flex items-center justify-center w-11 h-11 -mr-2 text-txt-muted hover:text-txt-primary transition-colors"
    aria-label="Abrir menú"
    aria-expanded="false"
    aria-controls="mobile-menu"
  >
    <Icon name="menu" size={20} class="menu-icon" />
    <Icon name="x" size={20} class="close-icon hidden" />
  </button>
</nav>

<!-- Mobile menu -->
<nav
  id="mobile-menu"
  aria-label="Menú móvil"
  class="hidden md:hidden fixed top-[72px] left-0 right-0 z-40 bg-bg-surface/95 backdrop-blur-xl border-b border-border-subtle p-6 flex flex-col gap-4"
>
  {
    links.map((link, index) => (
      <a
        href={link.href}
        class:list={[
          'text-[15px] py-3 transition-all duration-300 pl-3 border-l-2 min-h-[44px] flex items-center',
          isActive(link.href)
            ? 'text-accent font-medium border-accent'
            : 'text-txt-muted border-transparent hover:border-txt-muted hover:text-txt-primary',
        ]}
        style={`animation-delay: ${index * 50}ms`}
      >
        {link.label}
      </a>
    ))
  }
  <div class="flex items-center justify-between py-2 pl-3 border-l-2 border-transparent">
    <span class="text-[15px] text-txt-muted">Tema</span>
    <button
      id="mobile-theme-toggle"
      type="button"
      class="flex items-center justify-center w-11 h-11 rounded-lg text-txt-muted hover:text-txt-primary transition-colors"
      aria-label="Cambiar tema"
    >
      <Icon name="moon" size={20} class="mobile-moon-icon" />
      <Icon name="sun" size={20} class="mobile-sun-icon hidden" />
    </button>
  </div>
  <a
    href="/servicios"
    class="flex items-center justify-center px-5 py-3 min-h-[44px] border-2 border-accent text-accent text-sm font-semibold rounded-full hover:bg-accent hover:text-bg-deep transition-all duration-300 mt-2"
  >
    Hablemos
  </a>
</nav>

<script>
  const btn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = btn?.querySelector('.menu-icon') as HTMLElement | null;
  const closeIcon = btn?.querySelector('.close-icon') as HTMLElement | null;

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
    const expanded = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!expanded));
  });

  // Theme toggle functionality (desktop + mobile)
  const themeToggle = document.getElementById('theme-toggle');
  const mobileThemeToggle = document.getElementById('mobile-theme-toggle');
  const moonIcon = themeToggle?.querySelector(
    '.moon-icon',
  ) as HTMLElement | null;
  const sunIcon = themeToggle?.querySelector('.sun-icon') as HTMLElement | null;
  const mobileMoonIcon = mobileThemeToggle?.querySelector(
    '.mobile-moon-icon',
  ) as HTMLElement | null;
  const mobileSunIcon = mobileThemeToggle?.querySelector(
    '.mobile-sun-icon',
  ) as HTMLElement | null;

  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      moonIcon?.classList.add('hidden');
      sunIcon?.classList.remove('hidden');
      mobileMoonIcon?.classList.add('hidden');
      mobileSunIcon?.classList.remove('hidden');
    } else {
      moonIcon?.classList.remove('hidden');
      sunIcon?.classList.add('hidden');
      mobileMoonIcon?.classList.remove('hidden');
      mobileSunIcon?.classList.add('hidden');
    }
  }

  // Initialize icons on page load
  updateThemeIcons();

  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {
      // The theme still changes for this page when privacy mode rejects
      // persistence. A preference write must never break the control.
    }
    updateThemeIcons();
  }

  themeToggle?.addEventListener('click', toggleTheme);
  mobileThemeToggle?.addEventListener('click', toggleTheme);
</script>

<style>
  /* Nav links hover underline effect */
  .nav-link:hover span {
    width: 100%;
  }

  /* Staggered fade-in for nav links */
  .nav-link {
    opacity: 0;
    animation: slideIn 0.4s ease-out forwards;
  }

  @keyframes slideIn {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
