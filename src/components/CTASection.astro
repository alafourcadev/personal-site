---
// Reusable call-to-action section: optional eyebrow, title, description,
// primary action and optional secondary action. Center or left aligned.
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  align?: 'center' | 'left';
}

const {
  eyebrow,
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  align = 'center',
} = Astro.props;

const alignClass = align === 'center' ? 'items-center text-center' : 'items-start text-left';
---

<section class="my-16">
  <div
    class:list={[
      'flex flex-col gap-6 rounded-xl border border-border-subtle bg-bg-surface px-6 py-12 md:px-12 md:py-16',
      alignClass,
    ]}
  >
    {eyebrow && (
      <span class="font-mono text-xs uppercase tracking-[0.15em] text-accent">{eyebrow}</span>
    )}
    <h2 class="font-heading text-2xl md:text-3xl font-extrabold leading-tight text-txt-primary max-w-2xl">
      {title}
    </h2>
    {description && (
      <p class="text-txt-secondary leading-relaxed max-w-xl">{description}</p>
    )}
    <div class="mt-2 flex flex-col gap-3 sm:flex-row">
      <a
        href={primaryHref}
        class="inline-flex items-center justify-center rounded-md bg-accent px-6 py-3 font-semibold text-bg-deep transition-colors hover:bg-accent-strong"
      >
        {primaryLabel}
      </a>
      {secondaryLabel && secondaryHref && (
        <a
          href={secondaryHref}
          class="inline-flex items-center justify-center rounded-md border border-border-subtle px-6 py-3 font-semibold text-txt-primary transition-colors hover:border-accent hover:text-accent"
        >
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>
