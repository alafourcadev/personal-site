---
// Font imports. Latin subset only (covers Spanish: áéíóúñ¿¡)
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/outfit/latin-700.css';
import '@fontsource/outfit/latin-800.css';

import Navbar from '../components/Navbar.astro';
import TypewriterLogo from '../components/TypewriterLogo.astro';
import FooterFull from '../components/FooterFull.astro';
import FooterSimple from '../components/FooterSimple.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  navVariant?: 'home' | 'blog';
  footerVariant?: 'full' | 'simple';
  noindex?: boolean;
  // Which shell the page gets.
  //
  // 'site' is every article, list and landing there is, and is the default
  // precisely so nothing about them can change by accident: the navigation,
  // the footer and the shared centred column.
  //
  // 'app' is La Forja's exercise screen, which is a tool and takes the whole
  // window: no navigation, no footer, no centred column, and no page scroll
  // above the playable width (each rail scrolls inside itself instead). It is
  // a property of this layout rather than a second layout on purpose. The two
  // theme token blocks and the script that decides the theme before the first
  // paint live here, and a copy of them is a copy that drifts.
  chrome?: 'site' | 'app';
}

const {
  title,
  description = 'Ingeniería sin filtros, por Alejandro Lafourcade',
  image,
  type = 'website',
  navVariant = 'home',
  footerVariant = 'full',
  noindex = false,
  chrome = 'site',
} = Astro.props;

const app = chrome === 'app';

const ogImage = image || 'https://alafourca.dev/og-image.png';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Alejandro Lafourcade" />
    <link rel="canonical" href={Astro.url.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" type="application/rss+xml" title="Ingeniería sin filtros" href="/rss.xml" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Ingeniería sin filtros" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@alafourcadev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Alejandro Lafourcade",
      "jobTitle": "Tech Lead & Software Engineer",
      "url": "https://alafourca.dev",
      "sameAs": [
        "https://x.com/alafourcadev",
        "https://www.linkedin.com/in/alafourcadedespaigne/",
        "https://github.com/alafourcadev"
      ]
    })} />
    <meta name="theme-color" content="#0a0f1a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <link rel="alternate" hreflang="es" href={Astro.url.href} />
    <slot name="head" />
    <script is:inline>
      // Load theme before page renders to prevent flash
      (function () {
        let saved = null;
        try {
          saved = localStorage.getItem('theme');
        } catch {
          // Some privacy modes expose localStorage but reject access. The
          // default dark theme still renders correctly without persistence.
        }
        if (saved === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "f2044e16dcba4f17ae6792df334e9d1b"}'></script>
    <script defer src="https://cloud.umami.is/script.js" data-website-id="7a77490e-3189-4843-84c2-b5971d0bbc81"></script>
    <style>
      #scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        width: 0%;
        height: 3px;
        background: rgb(var(--accent));
        z-index: 100;
        transition: width 0.1s ease;
      }
      .copy-code-button {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgb(var(--txt-muted));
        background: rgb(var(--bg-deep));
        border: 1px solid rgb(var(--border-subtle));
        border-radius: 6px;
        cursor: pointer;
        opacity: 0;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 10;
      }
      pre:hover .copy-code-button {
        opacity: 1;
      }
      .copy-code-button:hover {
        color: rgb(var(--accent-strong));
        border-color: rgb(var(--accent-strong));
        background: rgb(var(--bg-surface-hover));
        transform: scale(1.05);
      }
      .copy-code-button:active {
        transform: scale(0.95);
      }
      .copy-code-button.copied {
        color: rgb(var(--accent-strong));
        border-color: rgb(var(--accent-strong));
        background: rgb(var(--accent-strong) / 0.1);
      }
      pre {
        position: relative;
      }
    </style>
  </head>
  <body
    class:list={[
      'bg-bg-deep text-txt-primary font-sans antialiased overflow-x-hidden',
      // "Sin scroll de página": above the playable width the shell owns the
      // window's height and every rail scrolls inside itself. Below it the
      // page is a reading screen and has to scroll again, which is why the
      // lock is behind `md` rather than unconditional.
      app && 'md:h-screen md:overflow-hidden',
    ]}
  >
    {!app && <div id="scroll-progress" />}
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent focus:text-bg-deep focus:rounded-lg focus:font-bold">
      Saltar al contenido
    </a>
    {
      app ? (
        <main id="main-content" class="md:flex md:h-full md:flex-col md:overflow-hidden">
          <slot />
        </main>
      ) : (
        <Fragment>
          <TypewriterLogo />
          <Navbar variant={navVariant} />
          <div class="max-w-[1440px] mx-auto">
            <main id="main-content" class="pt-20">
              <slot />
            </main>
            {footerVariant === 'full' ? <FooterFull /> : <FooterSimple />}
          </div>
        </Fragment>
      )
    }

    <script is:inline>
      // Reading Progress Bar. Absent in app chrome, where there is no page to
      // scroll, and the guard is what keeps this listener from throwing on every
      // wheel event there and taking the rest of this script with it.
      window.addEventListener('scroll', () => {
        const bar = document.getElementById('scroll-progress');
        if (!bar) return;
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        bar.style.width = scrolled + '%';
      });

      // Code Copy Button
      document.addEventListener('DOMContentLoaded', () => {
        const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
        const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

        const codeBlocks = document.querySelectorAll('pre');
        
        codeBlocks.forEach((block) => {
          if (block.querySelector('.copy-code-button')) return;

          const button = document.createElement('button');
          button.className = 'copy-code-button';
          button.setAttribute('aria-label', 'Copiar código');
          button.innerHTML = copyIcon;
          
          block.appendChild(button);

          button.addEventListener('click', async () => {
            const code = block.querySelector('code').innerText;
            try {
              await navigator.clipboard.writeText(code);
              button.innerHTML = checkIcon;
              button.classList.add('copied');
              
              setTimeout(() => {
                button.innerHTML = copyIcon;
                button.classList.remove('copied');
              }, 2000);
            } catch (err) {
              console.error('Failed to copy: ', err);
            }
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  html {
    scroll-behavior: smooth;
  }

  /* Light mode (default when no dark class) */
  :root {
    --bg-deep: 236 240 246;
    --bg-surface: 248 250 252;
    --bg-surface-hover: 240 244 248;
    --border-subtle: 226 232 240;
    --code-bg: 228 233 240;
    --txt-primary: 30 41 59;
    --txt-secondary: 71 85 105;
    --txt-muted: 91 107 129;
    --accent: 16 185 129;
    --accent-strong: 5 150 105;
    --accent-amber: 217 119 6;
    --accent-red: 220 38 38;
    --accent-blue: 37 99 235;
    --tag-bg: 236 253 245;
    --tag-text: 4 120 87;
    --nav-bg: rgba(255, 255, 255, 0.8);
    --scrollbar-track: #f1f5f9;
    --scrollbar-thumb: #cbd5e1;
    --scrollbar-thumb-hover: #94a3b8;

    /* The ink on an accent-coloured surface. The accent green is the same
       rgb(16 185 129) in both themes, so the ink on it must not flip either:
       --bg-deep did, and that is what turned every green button's label from
       7.55:1 to 2.22:1 the moment the page went light. Declared here and
       deliberately NOT redeclared in html.dark. */
    --on-accent: 10 15 26;
    /* Accent-coloured TEXT, which is a different job from an accent surface:
       the green reads 2.26:1 on a tint of itself over a light panel. Same
       value as --accent on dark, where nothing was wrong. */
    --accent-ink: 4 120 87;
    /* Red TEXT, same story: the site red is 4.27:1 on the failed-objective
       card at 12px, and that card is where a player reads what a mistake
       cost. */
    --danger-ink: 185 28 28;
    /* A surface that FLOATS above the panel: menus, tooltips. Not
       --bg-surface-hover, which is a hover state and is therefore correctly
       darker than the panel on a light theme. That is exactly why the
       tooltips shipped darker than the thing they floated over. */
    --bg-raised: 255 255 255;
    /* The outline of a card. --border-subtle is 1.18:1 here, which is not a
       boundary; on the light theme there is no lighter surface left to
       separate a card with, so the line has to do it. */
    --border-card: 125 139 160;
    /* Elevation on a light theme is SHADOW. On a dark one it is surface and
       line, so this is `none` there. Two mechanisms for one hierarchy, not an
       inversion. Navbar.astro has shipped the same idea as
       `shadow-lg shadow-black/5 dark:shadow-black/25` since long before this. */
    --elevation-1: 0 1px 2px rgb(15 23 42 / 0.06), 0 4px 12px rgb(15 23 42 / 0.08);

    /* -- La Forja's playground -------------------------------------------
       Whole CSS values rather than channel triplets: React Flow consumes them
       through its own --xy-* custom properties, which take a colour, and the
       four that resolve to another token need no per-theme copy at all: the
       substitution happens on the element, so they follow whichever --bg-deep
       / --txt-muted / --txt-primary is in force. */
    --forja-pane: rgb(var(--bg-deep));
    --forja-edge-default: rgb(var(--txt-muted));
    --forja-edge-selected: rgb(var(--txt-primary));
    --forja-edge-error: rgb(var(--danger-ink));
    /* An accent the pane can carry: the selection ring and the connection
       handle are graphical objects, and --accent is 2.22:1 on the light
       pane. */
    --forja-mark: rgb(var(--accent-strong));
    /* The dot grid. Decorative, so it is set to be felt rather than read:
       1.56:1 off this pane, which is the distance the dark theme now matches.
       Unchanged, because it was already the quiet one of the pair. */
    --forja-pane-pattern: #b8c3d4;
    /* React Flow's own default here is #eee, 1.1:1 against its own button. */
    --forja-controls-border: #94a3b8;
    /* The three band rules. They shipped as border-subtle at 50%, which is
       1.04:1 on this theme and 1.15:1 on the dark one, invisible in both, so
       both get a value. */
    --forja-band-divider: #94a3b8;
    /* The connection handle at rest. It is a dot, not a control, so it stays
       quiet; 0.5 of --txt-muted is quieter on this theme than on the dark one
       because the token itself is closer to the pane. */
    --forja-grip-rest-opacity: 0.7;
    /* The four data classes. Each is drawn three times: as the connection's
       stroke, as its 11px name, and as the 12px dot in the menu that declares
       it. The menu has always followed the site's theme, so these four were
       already being drawn at 1.60-2.53:1 on a light page. */
    --forja-class-public: #047857;
    --forja-class-personal: #1d4ed8;
    --forja-class-regulated: #a8500a;
    --forja-class-secret: #7e22ce;
  }

  /* Dark mode (when dark class is present) */
  html.dark {
    --bg-deep: 10 15 26;
    --bg-surface: 19 27 46;
    --bg-surface-hover: 26 37 64;
    --border-subtle: 30 45 74;
    --code-bg: 13 17 23;
    --txt-primary: 226 232 240;
    --txt-secondary: 148 163 184;
    --txt-muted: 124 141 181;
    --accent: 16 185 129;
    --accent-strong: 52 211 153;
    --accent-amber: 251 191 36;
    --accent-red: 248 113 113;
    --accent-blue: 96 165 250;
    --tag-bg: 6 78 59;
    --tag-text: 110 231 183;
    --nav-bg: rgba(15, 23, 42, 0.8);
    --scrollbar-track: #0f172a;
    --scrollbar-thumb: #334155;
    --scrollbar-thumb-hover: #475569;

    /* --on-accent is absent on purpose: it is the one token that must not
       flip. See the light block. */
    --accent-ink: 16 185 129;
    --danger-ink: 248 113 113;
    --bg-raised: 26 37 64;
    /* A card's outline, and NOT the same value --border-subtle carries.
       It was, and that made the dark contract spend nothing: elevation here is
       declared as surface plus line, --elevation-1 is `none`, and the line was
       1.25:1 against the panel a finding sits on and 1.11:1 against the raised
       surface a menu is painted with. Invisible in the theme this product
       actually opens in.
       Measured for this value: 1.98:1 against --bg-surface, 1.76:1 against
       --bg-raised, 2.21:1 against the pane those float over. Short of the
       light theme's 3:1 on purpose, because there a white card on a white
       panel has nothing but the line, while here the surface step already says
       most of it and a 3:1 hairline around every card would be a cage. */
    --border-card: 52 76 115;
    --elevation-1: none;

    /* -- La Forja's playground -------------------------------------------
       Only the values that genuinely differ are repeated here. --forja-pane,
       --forja-edge-default, --forja-edge-selected and --forja-edge-error
       resolve through tokens this block already redeclares, so they flip on
       their own. */
    --forja-mark: rgb(var(--accent));
    /* The dot grid. This was React Flow's own dark default (#555555) spelled
       out, which is not the same thing as chosen: measured, it sat 2.57:1 off
       this pane while the light theme's grid sat 1.56:1 off its own. One
       product had two different working surfaces, and the louder of them was
       on the theme it opens in. This value puts the dark grid at the light
       one's measured distance (1.55:1 against 1.56:1), so the surface reads
       the same whichever switch the player pressed. See canvas-background.ts
       for the dot itself. */
    --forja-pane-pattern: #253550;
    --forja-controls-border: #5b5b5b;
    /* Matched to the light divider's 2.24:1 against its own pane, so the band
       rules read the same way in both themes. */
    --forja-band-divider: #334c73;
    --forja-grip-rest-opacity: 0.5;
    --forja-class-public: #34d399;
    --forja-class-personal: #60a5fa;
    --forja-class-regulated: #fbbf24;
    --forja-class-secret: #c084fc;
  }

  /* Apply CSS variables */
  body {
    background-color: rgb(var(--bg-deep));
    color: rgb(var(--txt-primary));
  }

  ::selection {
    background: rgba(16, 185, 129, 0.3);
    color: inherit;
  }

  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: var(--scrollbar-track);
  }
  ::-webkit-scrollbar-thumb {
    background: var(--scrollbar-thumb);
    border-radius: 9999px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: var(--scrollbar-thumb-hover);
  }

  a:focus-visible, button:focus-visible {
    outline: 2px solid rgb(var(--accent));
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Theme-aware card hover shadow */
  .card-hover-shadow:hover {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }
  html.dark .card-hover-shadow:hover {
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
  }

  /* Editorial blocks, rendered from `:::name` directives in .md/.mdx posts.
     See src/plugins/remark-editorial-blocks.mjs */
  .ed-block {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid rgb(var(--txt-muted));
    border-radius: 0 0.75rem 0.75rem 0;
    background: rgb(var(--bg-surface));
  }
  .ed-block::before {
    content: attr(data-label);
    display: block;
    margin-bottom: 0.6rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--txt-muted));
  }
  .ed-block > :first-of-type {
    margin-top: 0;
  }
  .ed-block > :last-child {
    margin-bottom: 0;
  }

  .ed-problema-real { border-left-color: rgb(var(--accent-red)); }
  .ed-problema-real::before { color: rgb(var(--accent-red)); }
  .ed-la-trampa { border-left-color: rgb(var(--accent-amber)); }
  .ed-la-trampa::before { color: rgb(var(--accent-amber)); }
  .ed-la-decision { border-left-color: rgb(var(--accent)); }
  .ed-la-decision::before { color: rgb(var(--accent)); }
  .ed-regla-senior { border-left-color: rgb(var(--accent-blue)); }
  .ed-regla-senior::before { color: rgb(var(--accent-blue)); }
  .ed-checklist-produccion { border-left-color: rgb(var(--accent)); }
  .ed-checklist-produccion::before { color: rgb(var(--accent)); }

  /* Checklist: custom unchecked-box markers, non-interactive by default */
  .ed-checklist-produccion ul {
    list-style: none;
    padding-left: 0;
    margin: 0;
  }
  .ed-checklist-produccion li {
    position: relative;
    padding-left: 1.75rem;
    margin: 0.45rem 0;
  }
  .ed-checklist-produccion li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.25em;
    width: 1rem;
    height: 1rem;
    border: 2px solid rgb(var(--accent));
    border-radius: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
